# Copy this file to backend/.env and fill in your own value.
# backend/.env is gitignored and loaded automatically on backend startup.

# Free API key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=

# Free "Fixtures Only" token from https://app.pandascore.co/dashboard/main (esports data)
PANDASCORE_API_KEY=

# Only set this in a deploy with a mounted persistent volume (e.g. Railway),
# pointed at that volume's mount path, so the SQLite file survives restarts/redeploys.
# Leave unset for local dev (defaults to backend/data/).
BETHANY_DATA_DIR=

# Resend HTTP API for email verification codes (SMTP is not used: Railway blocks outbound
# SMTP ports, so delivery goes over plain HTTPS instead). Leave SMTP_PASSWORD unset for local
# dev — verification codes are logged instead of sent, so no real credential is needed to
# develop locally. Only fill these in in the deployed environment (see specs/009-verificacion-correo).
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
